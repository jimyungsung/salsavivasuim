# Copy to .env.local and fill in. Nothing here is committed.
# See docs/BUILD-PLAN.md §1 for why each of these is the choice it is.

# ---- Supabase (P1) ----------------------------------------------------------
# Project → Settings → API. The publishable key is safe in the browser; every
# table is protected by RLS, not by hiding the key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS — never expose to the client, never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---- Cloudflare Stream (P2/P3) ----------------------------------------------
# Account ID from the dashboard URL; the API token needs Stream:Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Signing key for short-lived playback tokens (~2h TTL), created via the
# /stream/keys endpoint. The PEM is base64 in the dashboard response.
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
# Shared secret Cloudflare signs its encoding webhooks with.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
